# Craft Harness environment variables.
# Copy this file to `.env` and fill in your Anthropic API key.
#
# Every other default already matches the Compose stack as seen from your
# machine: the backing services publish their ports, and the app runs on the
# host under `bun run dev`. You should not need to set anything else.

# ---- LLM ----
# Required. Used by the Aria agent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Override the default model.
# AGENT_MODEL=anthropic:claude-haiku-4-5-20251001

# ---- Mail (Greenmail by default) ----
# MAIL_HOST=localhost
# MAIL_IMAP_PORT=3143
# MAIL_SMTP_PORT=3025
# MAIL_USER=aria@harness.local
# MAIL_PASSWORD=aria
# MAIL_TLS=false
# MAIL_POLL_INTERVAL_MS=5000

# ---- Planka (mock kanban) ----
# PLANKA_BASE_URL=http://localhost:1337
# PLANKA_USER=demo@harness.local
# PLANKA_PASSWORD=demo
# PLANKA_PROJECT_NAME=Craft Harness
# PLANKA_BOARD_NAME=Tasks
# PLANKA_APPROVAL_LIST=Approved

# Shared secret Planka presents on its webhook, as `Authorization: Bearer`.
# Compose passes the same value to Planka, so changing it here changes both.
# PLANKA_WEBHOOK_SECRET=dev-secret-change-me

# ---- Knowledge base ----
# A directory of markdown files. Point it anywhere; the agent reads and
# writes it through the file() and directory() adapters.
# KNOWLEDGE_DIR=./knowledge

# ---- HTTP ----
# APP_HOST=0.0.0.0
# APP_PORT=3000
# MCP_PORT=3001

# ---- Identity ----
# Leave unset for the quick start: MCP calls with no token are treated as
# demo@harness.local, the user who may draft email but not send it.
# Set to false and the MCP endpoint demands a real Dex token.
# AUTH_DISABLED=false

# ---- Running the app in Compose instead of on the host ----
# Only needed with `docker compose --profile app up -d`. Without it Planka
# keeps posting webhooks to the host, where nothing is listening any more.
# APP_WEBHOOK_URL=http://app:3000/webhooks/planka
