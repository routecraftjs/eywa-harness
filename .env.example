# Craft Harness environment variables.
# Copy this file to `.env` and fill in your Anthropic API key.
# Everything else has sensible defaults that match the Compose stack.

# ---- LLM ----
# Required. Used by the Aria agent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Override the default model.
# AGENT_MODEL=anthropic:claude-haiku-4-5-20251001

# ---- Mail (Greenmail by default) ----
# MAIL_HOST=greenmail
# MAIL_IMAP_PORT=3143
# MAIL_SMTP_PORT=3025
# MAIL_USER=aria@harness.local
# MAIL_PASSWORD=aria
# MAIL_TLS=false
# MAIL_POLL_INTERVAL_MS=5000

# ---- Planka (mock kanban) ----
# PLANKA_BASE_URL=http://planka:1337
# PLANKA_USER=demo@harness.local
# PLANKA_PASSWORD=demo
# PLANKA_PROJECT_NAME=Craft Harness
# PLANKA_BOARD_NAME=Tasks
# PLANKA_WEBHOOK_SECRET=dev-secret-change-me

# ---- S3 (MinIO by default) ----
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_KNOWLEDGE_BUCKET=knowledge
# S3_FORCE_PATH_STYLE=true

# ---- HTTP ----
# APP_HOST=0.0.0.0
# APP_PORT=3000
# MCP_PORT=3001
