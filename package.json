{
  "name": "craft-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "description": "Routecraft showcase: an AI agent in 30 seconds with email, tickets, and MCP. Mock backends, zero credentials.",
  "scripts": {
    "start": "craft --log-level info run index.ts",
    "dev": "craft --log-level debug run index.ts",
    "lint": "eslint .",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.107",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@routecraft/ai": "0.6.0-canary-20260810101645",
    "@routecraft/cli": "0.6.0-canary-20260810101645",
    "@routecraft/routecraft": "0.6.0-canary-20260810101645",
    "gray-matter": "^4.0.3",
    "imapflow": "^1.6.6",
    "jose": "^6.2.8",
    "mailparser": "^3.9.15",
    "nodemailer": "^8.0.11",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@routecraft/eslint-plugin-routecraft": "0.6.0-canary-20260810101645",
    "@routecraft/testing": "0.6.0-canary-20260810101645",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
